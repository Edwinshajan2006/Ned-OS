#!/bin/bash

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

show_help() {
    cat <<EOF
NED-OS COMMAND CENTER

Usage:
  ned <command>

System:
  info              Show NED-OS information
  status            Show system status
  doctor            Run system diagnostics

Appearance:
  wallpaper         Manage wallpaper
  theme             Manage NED-OS theme

Power:
  power <action>    Lock, reboot, or shut down NED-OS
  shutdown          Shut down the system
  restart           Restart the system
  lock              Lock the current session
  kill              Close active GUI applications

Focus:
  focus             Start NED Focus mode
  focus stop        Stop NED Focus mode
  focus status      Show NED Focus status

Other:
  help              Show this help
EOF
}

case "${1:-help}" in

    info)
        exec "$root_dir/scripts/ned-info.sh"
        ;;

    status)
        exec "$root_dir/scripts/system-status.sh"
        ;;

    doctor)
        exec "$root_dir/scripts/ned-doctor.sh"
        ;;

    wallpaper)
        exec "$root_dir/scripts/ned-wallpaper.sh" "${@:2}"
        ;;

    theme)
        if [ -x "$root_dir/scripts/ned-theme.sh" ]; then
            exec "$root_dir/scripts/ned-theme.sh" "${@:2}"
        else
            echo "NED theme script not found."
        fi
        ;;

    power)
        if [ -x "$root_dir/scripts/ned-power.sh" ]; then
            exec "$root_dir/scripts/ned-power.sh" "${@:2}"
        else
            echo "NED power script not found."
        fi
        ;;

    shutdown)
        if [ -x "$root_dir/scripts/ned-power.sh" ]; then
            exec "$root_dir/scripts/ned-power.sh" shutdown
        else
            echo "NED power script not found."
        fi
        ;;

    restart)
        if [ -x "$root_dir/scripts/ned-power.sh" ]; then
            exec "$root_dir/scripts/ned-power.sh" restart
        else
            echo "NED power script not found."
        fi
        ;;

    lock)
        if [ -x "$root_dir/scripts/ned-power.sh" ]; then
            exec "$root_dir/scripts/ned-power.sh" lock
        else
            loginctl lock-session
        fi
        ;;

    kill)
        pkill -f "chrome" 2>/dev/null
        pkill -f "chromium" 2>/dev/null
        echo "Active GUI applications closed."
        ;;

    focus)
        exec "$root_dir/scripts/ned-focus.sh" "${2:-start}"
        ;;

    help)
        show_help
        ;;

    *)
        echo "Unknown command: $1"
        echo
        show_help
        exit 1
        ;;

esac

