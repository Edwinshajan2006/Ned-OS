#!/usr/bin/env bash
set -u
root_dir=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
usage() { cat <<'EOF'
NED-OS command line

Usage: ned <command>

Commands:
  info              Show NED-OS system information via Fastfetch
  status            Show a read-only system status snapshot
  doctor            Check NED-OS components without changing the system
  wallpaper [set]   Apply the bundled NED-OS wallpaper
  wallpaper path    Print the bundled wallpaper path
  theme             Display the active XFCE theme settings
  wifi              Scan and connect to a Wi-Fi network
  bluetooth         Scan and control Bluetooth devices
  power <action>    Lock, reboot, or shut down NED-OS
  help              Show this help
EOF
}
case "${1:-help}" in
    info) exec "$root_dir/scripts/ned-info.sh" ;; status) exec "$root_dir/scripts/system-status.sh" ;; doctor) exec "$root_dir/scripts/ned-doctor.sh" ;;
    wallpaper) shift; exec "$root_dir/scripts/ned-wallpaper.sh" "${1:-set}" ;; power) shift; exec "$root_dir/scripts/ned-power.sh" "${1:-}" ;;
    wifi)
        case "${2:-scan}" in
            scan)
                exec "$root_dir/scripts/ned-wifi.sh"
                ;;
            on)
                exec "$root_dir/scripts/ned-wifi-on.sh"
                ;;
            off)
                exec "$root_dir/scripts/ned-wifi-off.sh"
                ;;
            status)
                exec "$root_dir/scripts/ned-wifi-status.sh"
                ;;
            *)
                printf 'Usage: ned wifi [scan|on|off|status]\\n'
                exit 2
                ;;
        esac
        ;;
    bluetooth|bl)
        case "${2:-scan}" in
            scan)
                exec "$root_dir/scripts/ned-bluetooth.sh" scan
                ;;
            on)
                exec "$root_dir/scripts/ned-bluetooth.sh" on
                ;;
            off)
                exec "$root_dir/scripts/ned-bluetooth.sh" off
                ;;
            status)
                exec "$root_dir/scripts/ned-bluetooth.sh" status
                ;;
            devices)
                exec "$root_dir/scripts/ned-bluetooth.sh" devices
                ;;
            pair)
                exec "$root_dir/scripts/ned-bluetooth.sh" pair
                ;;
            connect)
                exec "$root_dir/scripts/ned-bluetooth.sh" connect
                ;;
            disconnect)
                exec "$root_dir/scripts/ned-bluetooth.sh" disconnect
                ;;
            erase)
                exec "$root_dir/scripts/ned-bluetooth.sh" erase
                ;;
            help|-h|--help)
                exec "$root_dir/scripts/ned-bluetooth.sh" help
                ;;
            *)
                printf 'Usage: ned bluetooth [scan|on|off|status]\n'
                exit 2
                ;;
        esac
        ;;
    theme)
        command -v xfconf-query >/dev/null 2>&1 || { printf 'XFCE settings tool is unavailable.\n' >&2; exit 1; }
        printf 'NED-OS THEME STATUS\n'
        for key in /Net/ThemeName /Net/IconThemeName /Gtk/CursorThemeName /Gtk/FontName /Gtk/MonospaceFontName; do printf '%-16s %s\n' "${key##*/}" "$(xfconf-query -c xsettings -p "$key" 2>/dev/null || printf 'unavailable')"; done ;;
    help|-h|--help) usage ;; *) printf 'Unknown command: %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
esac
